# Moon Maps environment variables. Copy this file to .env in the same folder (git ignores it)
# and fill in what you need. Never commit a real key. On a host (Vercel or another), set the
# same names in the project's environment settings instead.

# ---------- Web app (apps/web) ----------
# The web app reads apps/web/.env.local (copy apps/web/.env.example). On Vercel, set it on the
# web project. It is public: it is built into the browser code, so it must never hold a secret.
# NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------- API (apps/api) ----------
# Addresses allowed to call the API from a browser (a JSON list). Default: http://localhost:3000
# MM_CORS_ORIGINS=["https://your-web-app.vercel.app"]
# A pattern for extra addresses, for example Vercel preview deployments
# MM_CORS_ORIGIN_REGEX=https://your-web-app-.*\.vercel\.app
# The port the API listens on. Vercel containers expect 80 unless PORT is set; set PORT=8000 there.
# PORT=8000

# ---------- Assistant model keys (API) ----------
# The assistant uses every provider whose key is set, in this order, and moves to the next one
# when a provider is busy or out of free requests. With no key, the assistant is off.
# Free limits and sources: apps/api/app/services/providers.py and docs/backend/assistant.md.

# NVIDIA, about 10,000 requests a day. Key: "Get API Key" on any model page at https://build.nvidia.com
MM_NVIDIA_API_KEY=
# Groq, 1,000 requests a day. Key: https://console.groq.com
MM_GROQ_API_KEY=
# Google Gemini. Key: https://aistudio.google.com/api-keys (free-tier prompts are used by Google)
MM_GEMINI_API_KEY=
# Cloudflare Workers AI: an API token with Workers AI permission, and the account id
MM_CLOUDFLARE_API_TOKEN=
MM_CLOUDFLARE_ACCOUNT_ID=
# SambaNova, 20 requests a day per model. Key: https://cloud.sambanova.ai/apis
MM_SAMBANOVA_API_KEY=
# OpenRouter, 50 requests a day (1,000 after 10 dollars of credits). Key: https://openrouter.ai/keys
MM_OPENROUTER_API_KEY=
# Cohere trial, 1,000 calls a month. Key: https://dashboard.cohere.com/api-keys
MM_COHERE_API_KEY=

# Optional: any other OpenAI-compatible endpoint, tried last.
# MM_LLM_API_KEY=
# MM_LLM_BASE_URL=
# MM_LLM_MODELS=["model-id"]
# Optional: chat requests allowed per visitor.
# MM_ASSISTANT_PER_MINUTE=6
# MM_ASSISTANT_PER_DAY=60
